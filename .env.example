# ---------------------------------------------------------------------------
# Snabbily environment variables
# Copy this file to `.env.local` and fill in the values you have.
# Every variable below is OPTIONAL. The site degrades gracefully when a
# value is missing (forms, booking and analytics disable themselves cleanly).
# Never commit real values. `.env*` files are git-ignored.
# ---------------------------------------------------------------------------

# Formspree endpoint that receives Start Project and Free Review submissions.
# Create a form at https://formspree.io and paste its endpoint URL here.
# Example: https://formspree.io/f/xxxxxxxx
# If missing, forms show a friendly "not configured yet" message instead of failing.
VITE_SUBMIT_ENDPOINT=

# Cal.com booking link, e.g. "snabbily/intro-call" or a full https URL.
# If missing, all "Book a call" UI is hidden (no broken or empty booking widget is shown).
VITE_CAL_LINK=

# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX.
# Loaded only after the visitor accepts analytics cookies. If missing, GA never loads.
VITE_GA_MEASUREMENT_ID=

# Public site origin used for canonical URLs, sitemap and Open Graph tags.
# Defaults to https://snabbily.com when not set.
VITE_SITE_URL=https://snabbily.com
